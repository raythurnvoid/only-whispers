<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app": the unpacked app folder (a GitHub
     Actions artifact, so a zip). Signs our own executables only; upstream
     binaries such as llama-server are shipped unsigned, as SignPath requires. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="only-whispers.exe" product-name="only-whispers">
      <authenticode-sign/>
    </pe-file>
    <pe-file-set>
      <include path="resources/bin/windows-*.exe" min-matches="0" max-matches="unbounded" />
      <for-each>
        <authenticode-sign/>
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
