<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer": the NSIS installer built
     from the signed app folder (a GitHub Actions artifact, so a zip). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="*.exe" product-name="only-whispers">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
