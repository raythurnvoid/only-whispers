{
  "name": "only-whispers",
  "version": "0.1.6",
  "description": "Hold the Key, speak, and get clean text in any app. Mistral Voxtral speech-to-text with ChatGPT Luna cleanup.",
  "main": "main.js",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "compile:globe": "node scripts/build-globe-listener.js",
    "compile:fast-paste": "node scripts/build-macos-fast-paste.js",
    "compile:winkeys": "node scripts/build-windows-key-listener.js",
    "compile:linuxkeys": "node scripts/build-linux-key-listener.js",
    "compile:text-monitor": "node scripts/build-text-monitor.js",
    "compile:winpaste": "node scripts/build-windows-fast-paste.js",
    "compile:linux-paste": "node scripts/build-linux-fast-paste.js",
    "compile:media-remote": "node scripts/build-media-remote.js",
    "compile:mediaremote-adapter": "node scripts/build-mediaremote-adapter.js",
    "compile:mic-listener": "node scripts/build-macos-mic-listener.js",
    "compile:window-bounds": "node scripts/build-macos-window-bounds.js",
    "compile:native": "pnpm run compile:globe && pnpm run compile:fast-paste && pnpm run compile:winkeys && pnpm run compile:linuxkeys && pnpm run compile:winpaste && pnpm run compile:linux-paste && pnpm run compile:text-monitor && pnpm run compile:media-remote && pnpm run compile:mediaremote-adapter && pnpm run compile:mic-listener && pnpm run compile:window-bounds",
    "prestart": "pnpm run compile:native",
    "start": "electron .",
    "dev": "concurrently -k -r \"pnpm:dev:renderer\" \"pnpm:dev:main\"",
    "predev:main": "pnpm run compile:native",
    "dev:main": "cross-env NODE_ENV=development node scripts/run-electron.js --dev",
    "dev:renderer": "cd src && vite",
    "prebuild": "pnpm run compile:native",
    "build": "cd src && vite build && cd .. && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "build:renderer": "cd src && vite build",
    "compile:mac-icon": "node scripts/compile-macos-icon.js",
    "prebuild:mac": "pnpm run compile:native && pnpm run compile:mac-icon",
    "build:mac": "pnpm run build:renderer && electron-builder --mac",
    "build:mac:arm64": "pnpm run build:renderer && electron-builder --mac --arm64",
    "build:mac:x64": "pnpm run build:renderer && electron-builder --mac --x64",
    "prebuild:win": "pnpm run compile:native && pnpm run download:windows-fast-paste && pnpm run download:windows-key-listener",
    "build:win": "pnpm run build:renderer && electron-builder --win",
    "prebuild:linux": "pnpm run compile:native",
    "build:linux": "pnpm run build:renderer && electron-builder --linux",
    "build:linux:appimage": "pnpm run build:renderer && electron-builder --linux AppImage",
    "build:linux:deb": "pnpm run build:renderer && electron-builder --linux deb",
    "build:linux:rpm": "pnpm run build:renderer && electron-builder --linux rpm",
    "build:linux:tar": "pnpm run build:renderer && electron-builder --linux tar.gz",
    "prepack": "pnpm run compile:native",
    "pack": "pnpm run build:renderer && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "predist": "pnpm run compile:native",
    "dist": "pnpm run build:renderer && electron-builder",
    "download:nircmd": "node scripts/download-nircmd.js",
    "download:windows-fast-paste": "node scripts/download-windows-fast-paste.js",
    "download:windows-key-listener": "node scripts/download-windows-key-listener.js",
    "format:js": "eslint . --fix && cd src && eslint . --fix && prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format": "pnpm run format:js",
    "format:check": "eslint . && cd src && eslint . && prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "lint": "eslint . && cd src && eslint .",
    "test": "node --import tsx --test --test-force-exit --test-timeout=30000 \"test/**/*.test.js\"",
    "typecheck": "cd src && tsc --noEmit",
    "quality-check": "pnpm run format:check && pnpm run typecheck",
    "i18n:check": "node scripts/check-i18n.js",
    "preview": "cd src && vite preview",
    "clean": "node cleanup.js"
  },
  "keywords": [
    "dictation",
    "speech-to-text",
    "electron",
    "desktop-app"
  ],
  "author": {
    "name": "raythurnvoid"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/notarize": "^3.0.1",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.0.0",
    "electron": "^41.10.7",
    "electron-builder": "^26.4.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "17.5.0",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.1.10",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.1.6"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.41",
    "@fontsource-variable/cinzel": "^5.3.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@homebridge/dbus-native": "^0.7.9",
    "@napi-rs/keyring": "^1.3.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-direction": "1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.2.1",
    "ai": "^6.0.116",
    "better-sqlite3": "12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.1",
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.2.0",
    "i18next": "^26.3.6",
    "jose": "^6.2.13",
    "onnxruntime-node": "^1.21.0",
    "opencc-js": "^1.4.1",
    "ps-list": "^9.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.10",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn-ui": "^0.9.5",
    "tailwind-merge": "^3.3.1",
    "tar": "^7.5.22",
    "tw-animate-css": "^1.3.4",
    "unzipper": "^0.12.3",
    "ws": "8.21.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "@xmldom/xmldom": "0.8.15",
    "fast-xml-builder": "1.2.0",
    "fast-xml-parser": "5.7.2",
    "ip-address": "10.2.0",
    "markdown-it": "14.3.3",
    "shell-quote": "1.12.0",
    "tmp": "0.2.7"
  }
}
